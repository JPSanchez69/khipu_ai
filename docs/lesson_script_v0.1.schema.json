{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khipu.ai/schemas/lesson-script-0.1.json",
  "title": "LessonScript",
  "type": "object",
  "required": ["schemaVersion", "title", "actions"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "title": { "type": "string" },
    "subject": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "enum": [
              "writeText",
              "drawShape",
              "drawArrow",
              "highlight",
              "move",
              "erase",
              "timeline",
              "conceptNode",
              "wait",
              "speakCue",
              "askSocratic"
            ]
          },
          "id": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
